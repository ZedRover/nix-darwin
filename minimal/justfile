set shell := ["bash", "-cu"]

default: deploy

# 卸掉官方 nix-daemon，并为 Determinate daemon 注入代理（状态未变则不重启）。
configure-daemon:
    sudo bash {{justfile_directory()}}/modules/nix-daemon.sh

# 构建并切换系统配置
# Nix 走 daemon 代理（configure-daemon）；Homebrew 走 homebrew.onActivation.extraEnv。
deploy: configure-daemon
    sudo darwin-rebuild switch --flake .#zeds

# 更新 flake 输入到最新
update:
    nix flake update

# 只更新 Determinate，避免和本机自动升级的 daemon 脱节
update-determinate:
    nix flake update determinate

# 清理 nix store
gc:
    nix store gc
